{
  "name": "@uptimely/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Uptimely public API (https://app.getuptimely.com/v1).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/uptimely-sdk.git"
  },
  "homepage": "https://getuptimely.com/docs/api",
  "bugs": {
    "url": "https://github.com/DevinoSolutions/uptimely-sdk/issues"
  },
  "keywords": [
    "uptimely",
    "uptime",
    "monitoring",
    "status-page",
    "incidents",
    "api",
    "sdk",
    "webhooks",
    "typescript"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./webhooks": "./src/webhooks.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./webhooks": {
        "types": "./dist/webhooks.d.ts",
        "import": "./dist/webhooks.js",
        "require": "./dist/webhooks.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.contract-types.json && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "^20",
    "@uptimely/contracts": "workspace:*",
    "@uptimely/shared": "workspace:*",
    "size-limit": "13.0.3",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
