{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "..",
    "outDir": ".contract-types",
    "types": ["node"]
  },
  "include": ["../contracts/src/**/*", "../shared/src/**/*"],
  "exclude": ["**/*.test.ts"]
}
